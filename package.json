{
  "name": "aeroduct-cadcam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AeroDuct CAD/CAM - HVAC rectangular sheet metal duct fabrication & flat pattern layout engine",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build:single": "vite build --config vite.config.single.ts && node scripts/inline-single-file.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
